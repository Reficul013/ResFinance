          "voided",
          "source_event_id"
        ],
        "title": "TransactionModel",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoidTransactionCommand": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "reason": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "expected_version"
        ],
        "title": "VoidTransactionCommand",
        "type": "object"
      },
      "WalletIdentityModel": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "pattern": "^0x[0-9a-f]{40}$",
            "title": "Address",
            "type": "string"
          },
          "public_key": {
            "maxLength": 128,
            "minLength": 32,
            "title": "Public Key",
            "type": "string"
          }
        },
        "required": [
          "public_key",
          "address"
        ],
        "title": "WalletIdentityModel",
        "type": "object"
      }
    }
  },
