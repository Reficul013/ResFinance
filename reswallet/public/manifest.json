{
  "manifest_version": 3,
  "name": "ResWallet for ResFinance",
  "description": "Secure wallet identity and approval signing for ResFinance.",
  "version": "0.1.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/reswallet-16.png",
    "32": "icons/reswallet-32.png",
    "48": "icons/reswallet-48.png",
    "128": "icons/reswallet-128.png"
  },
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://app.resfinance.local/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/reswallet-16.png",
      "32": "icons/reswallet-32.png",
      "48": "icons/reswallet-48.png",
      "128": "icons/reswallet-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.resfinance.local/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
